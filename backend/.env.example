# Gorlami Backend Configuration
# Copy this file to .env and fill in your API keys

# Environment
NODE_ENV=development
PORT=8000
SERVER_HOST=0.0.0.0
# Required API Keys
DEEPGRAM_API_KEY="xxx"
AZURE_OPENAI_ENDPOINT_URL="https://xxx-app.openai.azure.com/"
AZURE_OPENAI_API_KEY="xxx"

# Supabase Configuration
SUPABASE_URL="https://xx.supabase.co"
SUPABASE_KEY="xx.xx.xx"

# Database Configuration
# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Logging
LOG_LEVEL=INFO

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=tauri://localhost